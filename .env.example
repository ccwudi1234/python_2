# 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# 环境类型: development 或 production
ENV=development

# 数据库连接字符串（生产环境）
DATABASE_URL=sqlite:///./backend/production.db

# JWT 密钥（生产环境请使用强密钥）
SECRET_KEY=your-super-secret-key-change-in-production-1234567890abcdefghij

# 允许的 CORS 来源（逗号分隔）
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
